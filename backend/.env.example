# ==============================================================================
# CARBONMESH V2 ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env for local overrides. Never commit .env with real keys!

# Server & Networking
HOST=0.0.0.0
PORT=8000

# SQLite Storage Path
DATABASE_PATH=carbonmesh.db

# Ingest Security: Allowed Clock Skew (seconds)
ALLOWED_CLOCK_SKEW_SECONDS=300.0

# Demo Node HMAC-SHA256 Secret Keys (for local testing)
NODE_KEY_01=demo_secret_key_node_01_2026
NODE_KEY_ESP32_01=esp32_secret_kwh_monitor_2026
NODE_KEY_NXP_01=nxp_mcxn947_secret_key_2026
NODE_KEY_KIOSK_01=kiosk_mobile_secret_key_2026

# Hub Control Signing Key
HUB_CONTROL_KEY=carbonmesh_hub_control_secret_2026

# Optional Local AI Model (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
